# Settings for the WEBSITE (server.js).
#
# On Render: don't use a .env file. Put these in Render > your service >
# Environment instead. SETUP.md walks through each one.
# A .env file is only for running the website on your own computer.
#
# The camera computer at the gym (laptop or Raspberry Pi) needs NONE of
# these: no API key, no token. It pairs with the website using a 6-digit
# code from the admin page (see AT-THE-GYM.md).

# --- Must have ---
# From console.anthropic.com > API Keys. The website counts people with it.
ANTHROPIC_API_KEY=
# A long random secret. Opens admin.html and lets camera computers pair.
# On Render, press "Generate".
ADMIN_TOKEN=

# --- Email: required, or nobody gets alerts ---
# Gmail with an app password (myaccount.google.com/apppasswords, needs
# 2-Step Verification on). SMTP_PASS is the 16-letter app password, not the
# Gmail password. Never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Your own address: support-form messages and "camera computer stopped"
# warnings come here.
SUPPORT_EMAIL=

# --- Keep data across deploys (strongly recommended on Render) ---
# Point at a mounted disk (Render > Disks, mount path /var/data). Without it,
# every deploy wipes the log, photos and gym accounts.
DATA_DIR=

# --- Optional ---
# The site's public address, used in links in emails and after checkout.
DOMAIN=http://localhost:4242
# Text-message alerts. Without these, alerts still go by email.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Card payments on checkout.html (sk_test_... while testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How long photos and the activity log are kept (hours). Flagged entries
# for the monthly report are kept 35 days regardless.
LOG_RETENTION_HOURS=48

# Not needed any more: RUNNER_TOKEN (camera computers pair with a code).
